generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SenderType {
  VISITOR
  AI_SUPPORT
  HUMAN_SUPPORT
}

model UserProfile {
  id String @id @db.Uuid

  username String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agents Agent[]
  subscription Subscription?

  @@map("user_profiles")
}

enum PlanType {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique @db.Uuid @map("user_id")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  
  plan PlanType @default(FREE) @map("plan")
  currentPeriodEnd DateTime? @map("current_period_end")
  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Agent {
  id String @id @default(cuid())

  userId String @db.Uuid @map("user_id")
  name String
  agentRole String @default("Chat Bot") @map("agent_role")
  isActive Boolean @default(false) @map("is_active")
  domain String
  systemPrompt String @map("system_prompt")
  welcomeMessage String @map("welcome_message")
  fallbackMessage String? @map("fallback_message")
  themeColor String @map("theme_color")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  rooms Room[]

  @@map("agents")
}

model Room {
  id String @id @default(cuid())

  agentId String @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, updatedAt])
  @@map("rooms")
}

model Message {
  id String @id @default(cuid())

  content String
  sender SenderType
  createdAt DateTime @default(now()) @map("created_at")

  roomId String @map("room_id")
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("messages")
}
